options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: T1114
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Not titled yet
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: center_freq
  id: variable
  parameters:
    comment: ''
    value: '2400000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [272, 24.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '30000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [176, 24.0]
    rotation: 0
    state: enabled
- name: plasma_bae_sink_0
  id: plasma_bae_sink
  parameters:
    affinity: ''
    alias: ''
    center_freq: center_freq
    center_freq_key: core:frequency
    comment: ''
    depth: '1'
    detection_indices_key: detection_indices
    dynamic_range: '60'
    dynamic_range_key: dynamic_range
    gui_hint: ''
    mode: '0'
    n_matrix_col_key: n_matrix_col
    nrow: '128'
    parent: None
    prf_key: radar:prf
    pulsewidth_key: radar:duration
    samp_rate: samp_rate
    samp_rate_key: core:sample_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 432.0]
    rotation: 0
    state: enabled
- name: plasma_signal_processing_0_3
  id: plasma_signal_processing
  parameters:
    affinity: ''
    alias: ''
    backend: plasma.Device.DEFAULT
    comment: ''
    fft_on: '1'
    fft_size: '1024'
    maxoutbuf: '0'
    minoutbuf: '0'
    n_pulse_cpi_key: n_pulse_cpi
    output_magnitude: '1'
    sample_rate: samp_rate
    window_type: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [648, 288.0]
    rotation: 0
    state: enabled
- name: plasma_spectro_sink_0_3
  id: plasma_spectro_sink
  parameters:
    affinity: ''
    alias: ''
    center_freq: center_freq
    center_freq_key: center_freq
    comment: ''
    depth: '1'
    fft_size: '1024'
    gui_hint: ''
    n_matrix_col_key: fft_size
    ncol: '128'
    parent: None
    samp_rate: samp_rate
    samp_rate_key: samp_rate
