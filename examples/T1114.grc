  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 296.0]
    rotation: 0
    state: enabled
- name: pluto_source_bae_0_3
  id: pluto_source_bae
  parameters:
    affinity: ''
    alias: ''
    auto_filter: 'True'
    bandwidth: samp_rate
    bbdc: 'True'
    buffer_size: '4096'
    comment: ''
    filter: '""'
    frequency: center_freq
    gain1: '"manual"'
    gain1_value: '10'
    gain2: '"manual"'
    gain2_value: '10'
    maxoutbuf: '0'
    minoutbuf: '0'
    pdu_duration: 100e-6
    quadrature: 'True'
    rf_port_select: '"A_BALANCED"'
    rfdc: 'True'
    rx1_en: 'True'
    rx2_en: 'True'
    rx_freq_key: core:rx_freq
    sample_start_key: core:sample_start
    samplerate: samp_rate
    tx_freq_key: core:tx_freq
    uri: ip:192.168.3.3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 184.0]
    rotation: 0
    state: enabled

connections:
- [plasma_signal_processing_0_3, out, plasma_bae_sink_0, in]
- [plasma_signal_processing_0_3, out, plasma_spectro_sink_0_3, in]
- [pluto_source_bae_0_3, out, plasma_signal_processing_0_3, rx]

metadata:
  file_format: 1
  grc_version: 3.10.9.2
